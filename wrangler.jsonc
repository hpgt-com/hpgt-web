// Cloudflare Workers: statiske filer fra ./dist. Bare /api/* kjører serverkode (worker/index.js – skjemaene RadioID og «Meld feil»).
// Hemmeligheter (legges inn én gang i Cloudflare: Workers & Pages → hpgt-web → Settings → Variables and Secrets, aldri i repoet):
//   TURNSTILE_SECRET         – fra Turnstile-widgeten «hpgt.com skjemaer»
//   GITHUB_APP_PRIVATE_KEY   – .pem-fila til GitHub-appen «HPGT Web Forms» (bare «Issues: Read and write», bare dette repoet)
// GH_APP_ID og GH_APP_INSTALLATION_ID er ikke hemmelige. De ligger som variabler i GitHub-miljøet «production»
// og sendes med ved publisering (.github/workflows/deploy.yml), sammen med Turnstile-nøkkelen til skjemaet.
{
  "name": "hpgt-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Bare hpgt.com og www.hpgt.com (custom domains, satt i Cloudflare). Uten disse slår hver publisering på
  // hpgt-web.hpgt.workers.dev og forhåndsvisningsadressene igjen.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GITHUB_REPO": "hpgt-com/form-submissions",
    "ALLOWED_ORIGIN": "https://hpgt.com",
    "TURNSTILE_HOSTNAME": "hpgt.com"
  },
  // Skjemaene: maks 3 innsendinger per minutt per IP-adresse. CSP-rapportene: maks 30 per minutt, telt under en hash av
  // adressen. Hver grense har sin egen namespace_id i kontoen HPGT (1002 brukes av datatjenesten for flysteder).
  "ratelimits": [
    { "name": "RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "CSP_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  // Workers Logs: én logglinje per kall til workeren (bare /api/*, skjemaene): tid, adresse, statuskode, varighet og
  // feil, med metadata om forespørselen (bl.a. IP og land). Lagres i inntil 7 dager hos Cloudflare
  // (Observability Free: aldri betalt, logging stopper for dagen ved grensen på 0,5 GB). Innholdet i skjemaene
  // logges ikke (workeren skriver ingenting med console.log). Ses under Workers & Pages → hpgt-web → Observability.
  // Bare Workerens egne linjer (console.log), uten Cloudflares logg per kall, som tar med IP-adresse og nettleser.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } }
}
