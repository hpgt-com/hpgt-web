{
  "name": "hpgt-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/translate/translate.mjs && astro dev",
    "build": "node scripts/check-media.mjs && node scripts/translate/translate.mjs && node scripts/video-thumbnails.mjs && astro build && node scripts/resize-images.mjs && node scripts/sitemap.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"test/*.test.js\"",
    "preview:build": "./scripts/build-preview.sh",
    "check:site": "node scripts/check-links.mjs && node scripts/check-accessibility.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.4.12",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.65.1"
  }
}
