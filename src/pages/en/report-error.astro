---
import Layout from "@design/Layout.astro";
import ReportErrorForm from "../../components/ReportErrorForm.astro";
---
<Layout title="Report an error" description="Tell us about errors or anything missing on hpgt.com.">
  <div class="wrap article"><h1 class="h1">Report an error</h1>
    <p>Have you seen something wrong, out of date or missing on the website? Let us know here and we will fix it. You are welcome to write in English.</p>
    <ReportErrorForm lang="en" /></div>
</Layout>
