---
import Layout from "@theme/Layout.astro";
import PostList from "@theme/PostList.astro";
import { hentInnlegg, hentKategorier, grupperPaaAar } from "../../lib/site";
const kategorier = await hentKategorier();
const grupper = grupperPaaAar(await hentInnlegg());
---
<Layout title="Nytt fra klubben">
  <PostList title="Nytt fra klubben" ingress="Nyheter, referater, kurs og turer – helt tilbake til 2012." grupper={grupper} kategorier={kategorier} />
</Layout>
