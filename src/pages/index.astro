---
import Layout from "@theme/Layout.astro";
import Home from "@theme/Home.astro";
import { hentInnlegg, hentArrangementer, site } from "../lib/site";
const innlegg = await hentInnlegg();
const { kommende, tidligere } = await hentArrangementer();
---
<Layout title={site.navn}>
  <Home innlegg={innlegg} kommende={kommende} tidligere={tidligere} />
</Layout>
