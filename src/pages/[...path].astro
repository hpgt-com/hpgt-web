---
// Alle innlegg (også arrangementer) og sider beholder adressene de hadde i WordPress, så gamle lenker fortsatt virker.
import { getCollection, render } from "astro:content";
import Layout from "@design/Layout.astro";
import Article from "@design/Article.astro";
import Styret from "../components/Styret.astro";
import RadioId from "../components/RadioId.astro";
import RadioIdSkjema from "../components/RadioIdSkjema.astro";
import Vedlegg from "../components/Vedlegg.astro";
import ArrangementBoks from "../components/ArrangementBoks.astro";
import KommendeKurs from "../components/KommendeKurs.astro";
import SeksjonOversikt from "../components/SeksjonOversikt.astro";
import KonkurranseOversikt from "../components/KonkurranseOversikt.astro";
import KursOversikt from "../components/KursOversikt.astro";
import { dato, url, lenke, kursLenke, site } from "../lib/site";
import Pil from "../components/Pil.astro";
import { arrangementLd, ldJson } from "../lib/strukturert";

export async function getStaticPaths() {
  const trim = (e: any) => lenke(e).replace(/^\/|\/$/g, "");
  const [innlegg, utkast, sider, kurs] = await Promise.all([getCollection("innlegg", (p) => !p.data.utkast), getCollection("innlegg", (p) => p.data.utkast), getCollection("sider"), getCollection("kurs")]);
  return [
    ...innlegg.map((entry) => ({ params: { path: trim(entry) }, props: { type: "innlegg", entry } })),
    // Utkast: forhåndsvisning på /utkast/<adresse>/. Ikke i lister, søk eller sitemap, og noindex.
    ...utkast.map((entry) => ({ params: { path: `utkast/${trim(entry)}` }, props: { type: "innlegg", entry, utkast: true } })),
    ...sider.map((entry) => ({ params: { path: trim(entry) }, props: { type: "side", entry } })),
    ...kurs.map((entry) => ({ params: { path: kursLenke(entry).replace(/^\/|\/$/g, "") }, props: { type: "kurs", entry } })),
  ];
}
const { type, entry, utkast = false } = Astro.props as any;
const { Content, headings } = await render(entry);
const d = entry.data;
let meta: string | undefined;
if (type === "innlegg") meta = `${d.forfatter ? `Av ${d.forfatter} · ` : ""}${dato(d.date)}`;
if (type !== "innlegg" && d.sist_endret) meta = `Sist oppdatert ${dato(d.sist_endret)}`;
const erArr = type === "innlegg" && d.arrangement?.start;
// «Kopier lenke»: kopierer innleggets adresse, så den kan limes inn i Facebook-gruppa (Facebooks delevindu kan ikke
// lenger dele i grupper). public/assets/js/kopier.js; uten JavaScript vises adressen som tekst.
const delLenke = type === "innlegg" && !utkast ? new URL(lenke(entry), site.url).href : null;
const tilbake = type === "kurs" ? { tekst: "Kurs", url: url("/kurs/") } : erArr ? { tekst: "Alle arrangementer", url: url("/arrangementer/") } : type === "innlegg" ? { tekst: "Alle nyheter", url: url("/nytt/") } : undefined;
---
<Layout title={utkast ? `Utkast: ${d.title}` : d.title} description={d.ingress} image={d.bilde} noindex={utkast}>
  <Article title={d.title} ingress={d.ingress} bilde={type !== "innlegg" ? d.bilde : undefined} meta={meta}
    kategorier={type === "innlegg" ? d.kategorier : undefined} tilbake={tilbake} type={type} overskrifter={headings}>
    {utkast && <aside class="utkast-merke" role="note"><strong>Utkast, bare forhåndsvisning.</strong> Denne adressen står ikke på forsiden, under Nytt eller i søket. Når innlegget er klart, fjerner du haken «Utkast» i Pages CMS. Da publiseres det på <code>{lenke(entry)}</code>.</aside>}
    {type === "kurs" && d.kurstype && <KommendeKurs type={d.kurstype} />}
    {erArr && !utkast && <script type="application/ld+json" set:html={ldJson(arrangementLd(entry, lenke(entry)))} />}
    {erArr && <ArrangementBoks a={d.arrangement} />}
    {d.mal === "kurs" && <KommendeKurs />}
    {d.mal === "kontakt" && <Styret />}
    {d.mal === "radioid" && <RadioId />}
    {d.mal === "bidra" && <p><a class="btn" href={site.cms}>Logg inn i Pages CMS <Pil /></a></p>}
    {d.mal === "konkurranser" && <KonkurranseOversikt />}
    <Content />
    {d.mal === "kurs" && <KursOversikt />}
    {d.mal === "seksjon" && <SeksjonOversikt />}
    {d.mal === "radioid" && <RadioIdSkjema />}
    {d.vedlegg?.length > 0 && <Vedlegg filer={d.vedlegg} />}
    {delLenke && <p class="del-lenke"><span data-kopier-tekst>Lenke til innlegget: <code>{delLenke}</code></span><button class="btn" type="button" data-kopier={delLenke} data-ok="Lenken er kopiert" hidden>Kopier lenke</button> <span class="del-lenke__status" role="status" aria-live="polite"></span></p>}
    {delLenke && <script is:inline src={url("/assets/js/kopier.js")} defer></script>}
  </Article>
</Layout>
