---
// Alle innlegg (også arrangementer) og sider beholder adressene de hadde i WordPress, så gamle lenker fortsatt virker.
import { getCollection, render } from "astro:content";
import Layout from "@design/Layout.astro";
import Article from "@design/Article.astro";
import Styret from "../components/Styret.astro";
import RadioId from "../components/RadioId.astro";
import RadioIdSkjema from "../components/RadioIdSkjema.astro";
import RedaktorDemo from "../components/RedaktorDemo.astro";
import Vedlegg from "../components/Vedlegg.astro";
import ArrangementBoks from "../components/ArrangementBoks.astro";
import KommendeKurs from "../components/KommendeKurs.astro";
import KursMeny from "../components/KursMeny.astro";
import KursOversikt from "../components/KursOversikt.astro";
import { dato, url, lenke, kursLenke } from "../lib/site";

export async function getStaticPaths() {
  const trim = (e: any) => lenke(e).replace(/^\/|\/$/g, "");
  const [innlegg, sider, kurs] = await Promise.all([getCollection("innlegg", (p) => !p.data.utkast), getCollection("sider"), getCollection("kurs")]);
  return [
    ...innlegg.map((entry) => ({ params: { path: trim(entry) }, props: { type: "innlegg", entry } })),
    ...sider.map((entry) => ({ params: { path: trim(entry) }, props: { type: "side", entry } })),
    ...kurs.map((entry) => ({ params: { path: kursLenke(entry).replace(/^\/|\/$/g, "") }, props: { type: "kurs", entry } })),
  ];
}
const { type, entry } = Astro.props as any;
const { Content, headings } = await render(entry);
const d = entry.data;
let meta: string | undefined;
if (type === "innlegg") meta = `${d.forfatter ? `Av ${d.forfatter} · ` : ""}${dato(d.date)}`;
if (type !== "innlegg" && d.sist_endret) meta = `Sist oppdatert ${dato(d.sist_endret)}`;
const erArr = type === "innlegg" && d.arrangement?.start;
const tilbake = type === "kurs" ? { tekst: "Kurs", url: url("/kurs/") } : erArr ? { tekst: "Alle arrangementer", url: url("/arrangementer/") } : type === "innlegg" ? { tekst: "Alle nyheter", url: url("/nytt/") } : undefined;
---
<Layout title={d.title} description={d.ingress} image={d.bilde}>
  <Article title={d.title} ingress={d.ingress} bilde={type !== "innlegg" ? d.bilde : undefined} meta={meta}
    kategorier={type === "innlegg" ? d.kategorier : undefined} tilbake={tilbake} type={type} overskrifter={headings}>
    {(type === "kurs" || d.mal === "kurs") && <KursMeny slot="foran" />}
    {type === "kurs" && d.kurstype && <KommendeKurs type={d.kurstype} />}
    {erArr && <ArrangementBoks a={d.arrangement} />}
    {d.mal === "kurs" && <KommendeKurs />}
    {d.mal === "kontakt" && <Styret />}
    {d.mal === "radioid" && <RadioId />}
    {d.mal === "redaktordemo" && <RedaktorDemo />}
    <Content />
    {d.mal === "kurs" && <KursOversikt />}
    {d.mal === "radioid" && <RadioIdSkjema />}
    {d.vedlegg?.length > 0 && <Vedlegg filer={d.vedlegg} />}
  </Article>
</Layout>
