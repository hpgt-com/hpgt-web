---
import ViewToggle from "../components/ViewToggle.astro";
import CardGrid from "../components/CardGrid.astro";
import SectionMenu from "../components/SectionMenu.astro";
import { url, link, slug } from "../lib/site";
import { pageInfo, categoryName, formatsFor, localPath } from "../lib/i18n";
const { title, lead, years, categories, active } = Astro.props;
const { lang } = pageInfo(Astro.url.pathname);
const { date } = formatsFor(lang);
const en = lang === "en";
---
<div class="wrap section">
  <SectionMenu />
  <p class="eyebrow">{en ? "Archive since 2012" : "Arkiv fra 2012"}</p>
  <h1 class="h1">{title}</h1>
  {lead && <p class="lead">{lead}</p>}
  <nav class="filters" aria-label={en ? "Categories" : "Kategorier"}>
    <a href={localPath(lang, "/nytt/")} aria-current={!active ? "page" : undefined}>{en ? "All" : "Alle"}</a>
    {categories.map((k) => <a href={localPath(lang, `/nytt/kategori/${k.slug}/`)} data-cat={k.slug} aria-current={active === k.slug ? "page" : undefined}>{categoryName(lang, k.name)} <small>{k.posts.length}</small></a>)}
    {/* Referatene er bare på norsk */}
    {en && <a href={url("/nytt/kategori/moter-og-referater/")} data-cat="moter-og-referater" lang="nb" hreflang="nb">Meetings and minutes (in Norwegian)</a>}
  </nav>
  <ViewToggle />
  {years.map(([year, posts]) => (
    <section class="year"><h2 class="year__h">{year}</h2>
      <ul class="rows" data-view="list">{posts.map((p) => <li><a href={url(link(p))}><time>{date(p.data.date)}</time><span>{p.data.title}</span><span class="cat" data-cat={slug(p.data.kategorier[0])}>{categoryName(lang, p.data.kategorier[0])}</span></a></li>)}</ul>
      <CardGrid posts={posts} />
    </section>
  ))}
</div>
