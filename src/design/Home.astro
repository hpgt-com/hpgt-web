---
import Aktivitetskalender from "../components/Aktivitetskalender.astro";
import { forside, url, dato, dag, mnd, lenke, slug, utdrag, bildeFor, tidSted } from "../lib/site";
const { innlegg, kommende, tidligere } = Astro.props;
const kort = (d: Date) => new Intl.DateTimeFormat("nb-NO", { timeZone: "UTC", day: "2-digit", month: "short", year: "numeric" }).format(d).replace(/\./g, "");
---
<section class="hero">
  <img class="hero__img" src={url(forside.heltebilde)} alt="Tandemflyging over snødekte fjell ved Harstad" />
  <div class="wrap hero__in">
    <p class="eyebrow eyebrow--light"><span class="dot" aria-hidden="true"></span>{forside.stikkord}</p>
    <h1 class="hero__title">{forside.slagord}</h1>
    <p class="hero__lead">{forside.slagordIngress}</p>
    <p class="actions">
      <a class="btn" href={url("/kurs/")}>Utforsk kurs <span aria-hidden="true">↗</span></a>
      <a class="btn btn--ghost" href={url("/flysteder/")}>Fly med oss <span aria-hidden="true">→</span></a>
      <a class="hero__cal" href="#aktivitetskalender">Aktivitetskalender ↓</a>
    </p>
    <div class="hero__strip"><span>Harstad / Sør-Troms</span><span>{forside.heltebildeKreditt}</span></div>
  </div>
</section>

<section class="wrap section">
  <div class="head"><div><p class="eyebrow">Ut i lufta</p><h2 class="h2">Finn din vei inn.</h2></div><a class="more" href={url("/om-oss/")}>Om klubben ↗</a></div>
  <div class="paths">
    {forside.veier.map((v, i) => (
      <a class="path" href={url(v.url)}>
        <span class="eyebrow">{String(i + 1).padStart(2, "0")} / {v.verb}</span>
        <span class="path__title">{v.tittel}</span>
        <span class="path__text">{v.tekst}</span>
        <span class="path__arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</section>

<hr class="wrap rule" />


<section class="wrap section">
  <div class="head"><div><p class="eyebrow">Fra klubben</p><h2 class="h2">Siste nytt</h2></div><a class="more" href={url("/nytt/")}>Alle innlegg →</a></div>
  <div class="news">
    {innlegg.slice(0, 3).map((p) => {
      const b = bildeFor(p);
      return (
        <a class="post" href={url(lenke(p))}>
          {b ? <img src={url(b)} alt="" loading="lazy" /> : <span class="post__noimg" aria-hidden="true"></span>}
          <span class="post__body">
            <span class="post__meta"><span class="kat" data-kat={slug(p.data.kategorier[0])}>{p.data.kategorier[0]}</span> · {kort(p.data.date)}</span>
            <span class="post__title">{p.data.title}</span>
            <span class="post__text">{utdrag(p.body, 150)}</span>
            {p.data.forfatter && <span class="post__by">Av <b>{p.data.forfatter}</b></span>}
          </span>
        </a>
      );
    })}
  </div>
</section>

<section class="band band--cal" id="aktivitetskalender">
  <div class="wrap section">
  <div class="head"><div><p class="eyebrow">Det skjer i HPGT</p><h2 class="h2">Aktivitetskalender</h2></div><a class="more" href={url("/arrangementer/")}>Alle arrangementer →</a></div>
  <Aktivitetskalender kommende={kommende} tidligere={tidligere} />
  </div>
</section>
