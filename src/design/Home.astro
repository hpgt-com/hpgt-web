---
import Img from "../components/Img.astro";
import Arrow from "../components/Arrow.astro";
import DefaultImage from "../components/DefaultImage.astro";
import ActivityCalendar from "../components/ActivityCalendar.astro";
import { url, link, slug, excerpt, imageFor } from "../lib/site";
import { T, pageInfo, frontPageFor, englishPaths, linkFor, categoryName, localPath } from "../lib/i18n";
const { posts, upcoming, past } = Astro.props;
// Engelsk forside: samme oppsett, med de oversatte nyhetene og arrangementene (src/pages/en/index.astro)
const { lang } = pageInfo(Astro.url.pathname);
const t = T[lang];
// Feltnavnene (heroImage, kicker, headline, paths …) er de samme som i front-page.json, som redigeres i Pages CMS
const frontPage = frontPageFor(lang);
const english = await englishPaths();
const href = (u: string) => linkFor(lang, u, english);
const en = lang === "en";
const shortDate = (d: Date) => new Intl.DateTimeFormat(en ? "en-GB" : "nb-NO", { timeZone: "UTC", day: "2-digit", month: "short", year: "numeric" }).format(d).replace(/\./g, "");
---
<section class="hero">
  <Img class="hero__img" src={frontPage.heroImage} sizes="100vw" alt={t.heroAlt} />
  <div class="wrap hero__in">
    <p class="eyebrow eyebrow--light"><span class="dot" aria-hidden="true"></span>{frontPage.kicker}</p>
    <h1 class="hero__title">{frontPage.headline}</h1>
    <p class="hero__lead">{frontPage.headlineLead}</p>
    <p class="actions">
      <a class="btn" href={href("/kurs/")}>{t.exploreCourses} <Arrow /></a>
      <a class="btn btn--ghost" href={href("/for-piloter/")}>{t.flyWithUs} <Arrow direction="right" /></a>
      <a class="hero__cal" href="#aktivitetskalender">{t.calendar}&nbsp;<Arrow direction="down" /></a>
    </p>
    <div class="hero__strip"><span>Harstad / Sør-Troms</span><span>{frontPage.heroImageCredit}</span></div>
  </div>
</section>

<section class="wrap section">
  <div class="head"><div><p class="eyebrow">{t.intoTheAir}</p><h2 class="h2">{t.findYourWay}</h2></div><a class="more" href={href("/klubben/")}>{t.aboutClub}&nbsp;<Arrow /></a></div>
  <div class="paths">
    {frontPage.paths.map((v, i) => (
      <a class="path" href={href(v.url)}>
        <span class="eyebrow">{String(i + 1).padStart(2, "0")} / {v.verb}</span>
        <span class="path__title">{v.title}</span>
        <span class="path__text">{v.text}</span>
        <span class="path__arrow" aria-hidden="true"><Arrow /></span>
      </a>
    ))}
  </div>
</section>

<hr class="wrap rule" />

<section class="wrap section">
  <div class="head"><div><p class="eyebrow">{en ? "From the club" : "Fra klubben"}</p><h2 class="h2">{en ? "Latest news" : "Siste nytt"}</h2></div><a class="more" href={localPath(lang, "/nytt/")}>{en ? "All posts" : "Alle innlegg"}&nbsp;<Arrow direction="right" /></a></div>
  <div class="news">
    {posts.slice(0, 3).map((p) => {
      const b = imageFor(p);
      return (
        <a class="post" href={url(link(p))}>
          {b ? <span class="post__noimg default-image--photo" data-cat={slug(p.data.categories[0])}><Img src={b} sizes="(min-width: 900px) 360px, 100vw" card loading="lazy" /><span class="default-image__label">{categoryName(lang, p.data.categories[0])}</span></span> : <DefaultImage class="post__noimg" cat={slug(p.data.categories[0])} label={categoryName(lang, p.data.categories[0])} seed={link(p)} />}
          <span class="post__body">
            <span class="post__meta">{shortDate(p.data.date)}{p.data.author && <> · <span class="post__by">{en ? "By" : "Av"} <b>{p.data.author}</b></span></>}</span>
            <span class="post__title">{p.data.title}</span>
            <span class="post__text">{excerpt(p.body, 110)}</span>
          </span>
        </a>
      );
    })}
  </div>
  {/* De tre neste innleggene i en rad med mindre kort: lite bilde med kategori, dato og forfatter, tittel og et kort utdrag */}
  {posts.length > 3 && (
    <div class="news news--small">
      {posts.slice(3, 6).map((p) => {
        const b = imageFor(p);
        return (
          <a class="post post--small" href={url(link(p))}>
            {b ? <span class="post__noimg default-image--photo" data-cat={slug(p.data.categories[0])}><Img src={b} sizes="100px" card loading="lazy" /><span class="default-image__label">{categoryName(lang, p.data.categories[0])}</span></span> : <DefaultImage class="post__noimg" cat={slug(p.data.categories[0])} label={categoryName(lang, p.data.categories[0])} seed={link(p)} />}
            <span class="post__body">
              <span class="post__meta">{shortDate(p.data.date)}{p.data.author && <> · <span class="post__by">{en ? "By" : "Av"} <b>{p.data.author}</b></span></>}</span>
              <span class="post__title">{p.data.title}</span>
              <span class="post__text">{excerpt(p.body, 70)}</span>
            </span>
          </a>
        );
      })}
    </div>
  )}
</section>

{/* Ankeret #aktivitetskalender er en del av adressen og beholdes */}
<section class="band band--cal" id="aktivitetskalender">
  <div class="wrap section">
  <div class="head"><div><p class="eyebrow">{en ? "What's on in HPGT" : "Det skjer i HPGT"}</p><h2 class="h2">{t.calendar}</h2></div><a class="more" href={localPath(lang, "/arrangementer/")}>{en ? "All events" : "Alle arrangementer"}&nbsp;<Arrow direction="right" /></a></div>
  <ActivityCalendar upcoming={upcoming} past={past} />
  </div>
</section>
