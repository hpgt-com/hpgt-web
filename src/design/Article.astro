---
import Img from "../components/Img.astro";
import { url, slug } from "../lib/site";
import TableOfContents from "./TableOfContents.astro";
import SectionMenu from "../components/SectionMenu.astro";
import { T, pageInfo, categoryName, localPath } from "../lib/i18n";
const { lang } = pageInfo(Astro.url.pathname);
const t = T[lang];
const { title, lead, image, meta, categories, back, headings = [] } = Astro.props;
// Innholdsfortegnelse bare når teksten har minst tre overskrifter
const toc = headings.filter((h: { depth: number }) => h.depth <= 3).length >= 3;
---
<article class:list={["wrap article", { "article--toc": toc }]}>
  {toc && <TableOfContents headings={headings} />}
  <div class="article__main">
    <nav class="crumbs" aria-label={t.breadcrumb}><a href={url(lang === "en" ? "/en/" : "/")}>{t.home}</a>{back && <><span>/</span><a href={back.url}>{back.label}</a></>}</nav>
    <SectionMenu />
    {meta && <p class="post__meta">{categories?.map((k) => <><a class="cat" data-cat={slug(k)} href={localPath(lang, `/nytt/kategori/${slug(k)}/`)}>{categoryName(lang, k)}</a> · </>)}{meta}</p>}
    <h1 class="h1">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    {image && <Img class="article__img" src={image} sizes="(min-width: 820px) 760px, 100vw" />}
    {toc && <TableOfContents headings={headings} mobile />}
    <div class="prose"><slot /></div>
  </div>
</article>
