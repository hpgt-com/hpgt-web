---
// Innholdsfortegnelse for lange sider: overskriftene i teksten (h2/h3). Vises til venstre på store skjermer
// og som en sammenleggbar boks øverst på mobil. public/assets/js/innhold.js markerer hvor du er på siden.
import type { MarkdownHeading } from "astro";
const { overskrifter, mobil = false } = Astro.props as { overskrifter: MarkdownHeading[]; mobil?: boolean };
const liste = overskrifter.filter((h) => h.depth <= 3);
const grunn = Math.min(...liste.map((h) => h.depth));
---
{mobil
  ? <details class="toc toc--mobil"><summary>På denne siden</summary><ol>{liste.map((h) => <li class={h.depth > grunn ? "toc__under" : undefined}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></details>
  : <nav class="toc toc--side" aria-label="På denne siden" data-toc><p class="toc__h">På denne siden</p><ol>{liste.map((h) => <li class={h.depth > grunn ? "toc__under" : undefined}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>}
