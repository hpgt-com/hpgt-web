---
import { url, dato, lenke, slug } from "../../lib/site";
const { title, ingress, grupper, kategorier, aktiv } = Astro.props;
---
<div class="wrap section">
  <nav class="crumbs" aria-label="Brødsmuler"><a href={url("/")}>Hjem</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
  <p class="eyebrow">Arkiv fra 2012</p>
  <h1 class="article__title">{title}</h1>
  {ingress && <p class="lead">{ingress}</p>}
  <div class="archive">
    <nav class="panel cats" aria-label="Kategorier">
      <a href={url("/nytt/")} aria-current={!aktiv ? "page" : undefined}>Alle</a>
      {kategorier.map((k) => <a href={url(`/nytt/kategori/${k.slug}/`)} data-kat={k.slug} aria-current={aktiv === k.slug ? "page" : undefined}><span><i class="kdot" aria-hidden="true"></i>{k.navn}</span><small>{k.poster.length}</small></a>)}
    </nav>
    <div>
      {grupper.map(([aar, poster]) => (
        <section class="year"><h2>{aar}</h2>
          <ul class="list">{poster.map((p) => <li><time>{dato(p.data.date)}</time><a href={url(lenke(p))}>{p.data.title}</a><span class="list__tags">{p.data.kategorier.map((k) => <span class="tag" data-kat={slug(k)}>{k}</span>)}</span></li>)}</ul>
        </section>
      ))}
    </div>
  </div>
</div>
