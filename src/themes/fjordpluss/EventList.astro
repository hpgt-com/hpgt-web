---
import { url, dato, tidSted, lenke } from "../../lib/site";
const { kommende, tidligere } = Astro.props;
---
<div class="wrap section">
  <p class="eyebrow">Kalender</p>
  <h1 class="h1">Aktiviteter</h1>
  <p class="lead">Kurs, sikkerhetsdager, årsmøter og sosiale treff.</p>
  <h2 class="h3">Kommende</h2>
  {kommende.length === 0 ? <p class="hint">Ingen nye aktiviteter er lagt inn ennå.</p> :
    <ol class="events">{kommende.map((e) => <li><a href={url(lenke(e))}><span class="events__date">{dato(e.data.start)}</span><span class="events__t">{e.data.title}</span><span class="events__where">{tidSted(e)}</span></a></li>)}</ol>}
  <h2 class="h3">Tidligere</h2>
  <ol class="events">{tidligere.map((e) => <li><a href={url(lenke(e))}><span class="events__date">{dato(e.data.start)}</span><span class="events__t">{e.data.title}</span><span class="events__where">{tidSted(e)}</span></a></li>)}</ol>
</div>
