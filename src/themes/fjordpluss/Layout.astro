---
import Head from "../../components/Head.astro";
import ProtoBanner from "../../components/ProtoBanner.astro";
import "../../components/proto.css";
import "@fontsource-variable/inter-tight/index.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "./style.css";
import { site, meny, url, ekstern } from "../../lib/site";
const { title, description, image } = Astro.props;
const here = Astro.url.pathname;
const aktiv = (u: string) => !ekstern(u) && (u === "/" ? here === url("/") : here.startsWith(url(u)));
---
<!doctype html>
<html lang="nb">
<head><Head title={title} description={description} image={image} /></head>
<body>
  <a class="skip" href="#innhold">Hopp til innhold</a>
  <ProtoBanner navn="6 · Fjord+ (egen CSS)" />
  <header class="top">
    <div class="wrap top__in">
      <a class="brand" href={url("/")}>
        <img src={url("/assets/img/hpgt-logo.png")} alt="" width="36" height="36" />
        <span><b>HPGT</b><small>Harstad Hang og Paragliderklubb</small></span>
      </a>
      <button class="menu-btn" type="button" data-menu-button aria-expanded="false" aria-controls="nav">Meny</button>
      <nav id="nav" class="nav" aria-label="Hovedmeny">
        {meny.hoved.map((m) => <a href={url(m.url)} aria-current={aktiv(m.url) ? "page" : undefined}>{m.tekst}{ekstern(m.url) && " ↗"}</a>)}
      </nav>
    </div>
  </header>
  <main id="innhold"><slot /></main>
  <footer class="foot">
    <div class="wrap foot__grid">
      <div><p class="foot__logo">HPGT</p><p class="muted">Harstad Hang og Paragliderklubb<br />Org.nr. {site.orgnr} · Vipps {site.vipps}</p></div>
      <nav aria-label="Klubben"><h2>Klubben</h2>{meny.klubben.map((m) => <a href={url(m.url)}>{m.tekst}</a>)}</nav>
      <nav aria-label="For piloter"><h2>For piloter</h2>{meny.piloter.map((m) => <a href={url(m.url)}>{m.tekst}{ekstern(m.url) && " ↗"}</a>)}</nav>
      <nav aria-label="Følg oss"><h2>Følg oss</h2><a href={site.facebook}>Facebook ↗</a><a href={site.instagram}>Instagram ↗</a><a href={`mailto:${site.epost.leder}`}>{site.epost.leder}</a></nav>
    </div>
    <div class="wrap foot__end"><p class="quote">«{site.sitat.tekst}» <span>– {site.sitat.kilde}</span></p><p class="muted">Ingen sporing eller informasjonskapsler.</p></div>
  </footer>
</body>
</html>
