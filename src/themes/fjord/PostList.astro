---
import { url, datoKort, slug, lenke } from "../../lib/site";
const { title, ingress, grupper, kategorier, aktiv } = Astro.props;
---
<div class="wrap article">
  <h1>{title}</h1>
  {ingress && <p class="lead">{ingress}</p>}
  <nav class="chips chips--filter" aria-label="Kategorier">
    <a href={url("/nytt/")} aria-current={!aktiv ? "page" : undefined}>Alle</a>
    {kategorier.map((k) => <a href={url(`/nytt/kategori/${k.slug}/`)} aria-current={aktiv === k.slug ? "page" : undefined}>{k.navn} <small>{k.poster.length}</small></a>)}
  </nav>
  {grupper.map(([aar, poster]) => (
    <section class="year"><h2>{aar}</h2>
      <ul class="list">{poster.map((p) => <li><time>{datoKort(p.data.date)}</time><a href={url(lenke(p))}>{p.data.title}</a><small>{p.data.kategorier.join(", ")}</small></li>)}</ul>
    </section>
  ))}
</div>
