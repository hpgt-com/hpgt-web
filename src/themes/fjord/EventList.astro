---
import { url, dato, dag, mnd, klokke, lenke } from "../../lib/site";
const { kommende, tidligere } = Astro.props;
---
<div class="wrap article">
  <h1>Arrangementer</h1>
  <p class="lead">Kurs, sikkerhetsdager, årsmøter og sosiale treff.</p>
  <h2 class="h-section">Kommende</h2>
  {kommende.length === 0 && <p class="empty">Ingen planlagte arrangementer akkurat nå. Følg med i Facebook-gruppa.</p>}
  <ul class="events">{kommende.map((e) => <li><a href={url(lenke(e))}><span class="date"><b>{dag(e.data.start)}</b>{mnd(e.data.start)}</span><span><span class="events__t">{e.data.title}</span><small>{e.data.sted}</small></span></a></li>)}</ul>
  <h2 class="h-section">Tidligere</h2>
  <ul class="list">{tidligere.map((e) => <li><time>{dato(e.data.start)}</time><a href={url(lenke(e))}>{e.data.title}</a><small>{e.data.sted}</small></li>)}</ul>
</div>
