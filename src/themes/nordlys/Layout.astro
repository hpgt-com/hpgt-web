---
import Head from "../../components/Head.astro";
import ProtoBanner from "../../components/ProtoBanner.astro";
import "../../components/proto.css";
import "./style.css";
import { site, meny, url, ekstern } from "../../lib/site";
const { title, description, image } = Astro.props;
const here = Astro.url.pathname;
const dock = [
  { tekst: "Hjem", url: "/", ikon: "M3 11l9-7 9 7M5 10v10h14V10" },
  { tekst: "Nytt", url: "/nytt/", ikon: "M4 5h16v14H4zM8 9h8M8 13h8M8 17h5" },
  { tekst: "Kalender", url: "/arrangementer/", ikon: "M4 6h16v14H4zM4 10h16M9 3v4M15 3v4" },
  { tekst: "Flysteder", url: "https://flysteder.hpgt.com/", ikon: "M12 21s7-6.5 7-12a7 7 0 0 0-14 0c0 5.5 7 12 7 12zM12 11a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" },
  { tekst: "Klubben", url: "/om-oss/", ikon: "M16 19v-1a4 4 0 0 0-8 0v1M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" },
];
---
<!doctype html>
<html lang="nb" data-theme="night">
<head><Head title={title} description={description} image={image} /></head>
<body class="min-h-screen pb-20 lg:pb-0">
  <a class="skip" href="#innhold">Hopp til innhold</a>
  <ProtoBanner navn="5 · Nordlys (daisyUI)" />
  <header class="navbar bg-base-100/80 backdrop-blur sticky top-0 z-20 border-b border-base-content/10">
    <div class="mx-auto w-full max-w-6xl flex items-center px-2">
      <a href={url("/")} class="btn btn-ghost text-lg gap-2"><img src={url("/assets/img/hpgt-logo.png")} alt="" width="32" height="32" class="rounded-full bg-white" />HPGT</a>
      <nav class="ml-auto hidden lg:flex" aria-label="Hovedmeny"><ul class="menu menu-horizontal gap-1">
        {meny.hoved.map((m) => <li><a href={url(m.url)} class:list={[!ekstern(m.url) && here.startsWith(url(m.url)) && "menu-active"]}>{m.tekst}{ekstern(m.url) && " ↗"}</a></li>)}
      </ul></nav>
      <a href={url("/bidra/")} class="btn btn-primary btn-sm ml-auto lg:ml-2">Skriv på siden</a>
    </div>
  </header>
  <main id="innhold" class="mx-auto max-w-6xl px-4"><slot /></main>
  <footer class="footer sm:footer-horizontal bg-base-200 text-base-content p-10 mt-16">
    <aside><p class="font-bold text-lg">HPGT</p><p>{site.navn}<br />Vipps {site.vipps} · Org.nr. {site.orgnr}</p></aside>
    <nav><h6 class="footer-title">For piloter</h6>{meny.piloter.map((m) => <a class="link link-hover" href={url(m.url)}>{m.tekst}</a>)}</nav>
    <nav><h6 class="footer-title">Klubben</h6>{meny.klubben.map((m) => <a class="link link-hover" href={url(m.url)}>{m.tekst}</a>)}</nav>
    <nav><h6 class="footer-title">Kontakt</h6><a class="link link-hover" href={url("/om-klubben/")}>Kontakt styret</a><a class="link link-hover" href={site.facebook}>Facebook</a><a class="link link-hover" href={site.instagram}>Instagram</a></nav>
  </footer>
  <nav class="dock lg:hidden" aria-label="Snarveier">
    {dock.map((d) => (
      <a href={url(d.url)} class:list={[(d.url === "/" ? here === url("/") : !ekstern(d.url) && here.startsWith(url(d.url))) && "dock-active"]}>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d.ikon} /></svg>
        <span class="dock-label">{d.tekst}</span>
      </a>
    ))}
  </nav>
</body>
</html>
