---
import { url, datoKort, lenke } from "../../lib/site";
const { title, ingress, grupper, kategorier, aktiv } = Astro.props;
---
<div class="py-8">
  <h1 class="text-4xl font-black">{title}</h1>
  {ingress && <p class="mt-2 opacity-80 max-w-2xl">{ingress}</p>}
  <div class="flex gap-2 overflow-x-auto py-4" role="navigation" aria-label="Kategorier">
    <a href={url("/nytt/")} class:list={["btn btn-sm rounded-full", aktiv ? "btn-ghost" : "btn-primary"]}>Alle</a>
    {kategorier.map((k) => <a href={url(`/nytt/kategori/${k.slug}/`)} class:list={["btn btn-sm rounded-full whitespace-nowrap", aktiv === k.slug ? "btn-primary" : "btn-ghost"]}>{k.navn} <span class="badge badge-xs">{k.poster.length}</span></a>)}
  </div>
  {grupper.map(([aar, poster]) => (
    <div class="collapse collapse-arrow bg-base-200 mb-2">
      <input type="checkbox" checked={aar >= 2026 || !!aktiv} aria-label={`Vis ${aar}`} />
      <div class="collapse-title font-bold text-lg">{aar} <span class="badge badge-sm ml-2">{poster.length}</span></div>
      <div class="collapse-content"><ul class="list">{poster.map((p) => <li class="list-row py-2"><span class="text-sm opacity-60 w-16">{datoKort(p.data.date)}</span><a href={url(lenke(p))} class="link link-hover font-medium">{p.data.title}</a></li>)}</ul></div>
    </div>
  ))}
</div>
