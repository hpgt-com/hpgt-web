---
import { url, dato, tidSted, lenke } from "../../lib/site";
const { kommende, tidligere } = Astro.props;
---
<h1 class="font-serif font-extrabold text-5xl">Kalender</h1>
<p class="mt-3 text-lg text-stone-600 dark:text-stone-400">Kurs, sikkerhetsdager, årsmøter og sosiale treff.</p>
<h2 class="mt-10 font-serif text-2xl font-semibold border-b-4 border-ink dark:border-stone-200 pb-2">Kommende</h2>
{kommende.length === 0 && <p class="py-4 text-stone-600">Ingen planlagte arrangementer akkurat nå. Følg med i Facebook-gruppa.</p>}
<ul>{kommende.map((e) => <li class="py-3 border-b border-stone-300"><a href={url(lenke(e))} class="font-semibold">{e.data.title}</a> <span class="text-sm text-stone-500">{dato(e.data.start)} · {tidSted(e)}</span></li>)}</ul>
<h2 class="mt-10 font-serif text-2xl font-semibold border-b-4 border-ink dark:border-stone-200 pb-2">Tidligere</h2>
<ul>{tidligere.map((e) => <li class="py-3 border-b border-stone-300 dark:border-stone-700 flex gap-4"><span class="w-40 shrink-0 text-sm text-stone-500">{dato(e.data.start)}</span><a href={url(lenke(e))} class="font-semibold hover:underline">{e.data.title}</a></li>)}</ul>
