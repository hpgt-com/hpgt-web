---
import { url } from "../../lib/site";
const { title, ingress, bilde, meta, kategorier, tilbake } = Astro.props;
---
<article class="mx-auto max-w-3xl">
  {tilbake && <a href={tilbake.url} class="text-sm font-semibold text-accent">← {tilbake.tekst}</a>}
  {meta && <p class="mt-6 text-xs uppercase tracking-widest text-accent font-semibold">{kategorier ? kategorier.join(", ") + " · " : ""}{meta}</p>}
  <h1 class="font-serif font-extrabold text-4xl md:text-6xl leading-tight mt-2">{title}</h1>
  {ingress && <p class="mt-4 text-xl text-stone-600 dark:text-stone-400 font-serif">{ingress}</p>}
  {bilde && <img src={url(bilde)} alt="" class="mt-8 w-full" />}
  <div class="prose prose-stone prose-lg dark:prose-invert mt-8 max-w-none prose-headings:font-serif prose-a:text-accent prose-img:my-4"><slot /></div>
</article>
