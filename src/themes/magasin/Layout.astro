---
import Head from "../../components/Head.astro";
import ProtoBanner from "../../components/ProtoBanner.astro";
import "../../components/proto.css";
import "./style.css";
import { site, meny, url, ekstern } from "../../lib/site";
const { title, description, image } = Astro.props;
const here = Astro.url.pathname;
---
<!doctype html>
<html lang="nb">
<head><Head title={title} description={description} image={image} /></head>
<body>
  <a class="skip" href="#innhold">Hopp til innhold</a>
  <ProtoBanner navn="3 · Magasin (Tailwind CSS)" />
  <header class="border-b-4 border-ink dark:border-stone-200">
    <div class="mx-auto max-w-6xl px-4 pt-6 pb-3 flex flex-wrap items-end gap-4">
      <a href={url("/")} class="mr-auto no-underline">
        <span class="block text-xs uppercase tracking-[.25em] text-accent font-semibold">Harstad Hang- og Paragliderklubb</span>
        <span class="block font-serif font-extrabold text-5xl md:text-6xl leading-none tracking-tight">HPGT</span>
      </a>
      <button class="menu-btn border border-current px-3 py-1 text-sm font-semibold" type="button" data-menu-button aria-expanded="false" aria-controls="nav">Meny</button>
    </div>
    <nav id="nav" class="navlinks mx-auto max-w-6xl px-4 flex flex-col md:flex-row gap-1 md:gap-6 pb-3 text-sm font-semibold uppercase tracking-wider" aria-label="Hovedmeny">
      {meny.hoved.map((m) => <a class:list={["hover:text-accent", !ekstern(m.url) && here.startsWith(url(m.url)) && "text-accent"]} href={url(m.url)}>{m.tekst}{ekstern(m.url) && " ↗"}</a>)}
    </nav>
  </header>
  <main id="innhold" class="mx-auto max-w-6xl px-4 py-8"><slot /></main>
  <footer class="bg-ink text-stone-300 dark:bg-black">
    <div class="mx-auto max-w-6xl px-4 py-12 grid gap-8 sm:grid-cols-2 md:grid-cols-4 text-sm">
      <div><p class="font-serif text-3xl font-extrabold text-white">HPGT</p><p class="mt-2">Harstad Hang- og Paragliderklubb<br />Org.nr. {site.orgnr} · Vipps {site.vipps}</p></div>
      <div><p class="uppercase tracking-widest text-xs text-white mb-2">For piloter</p>{meny.piloter.map((m) => <a class="block py-0.5 hover:text-white" href={url(m.url)}>{m.tekst}</a>)}</div>
      <div><p class="uppercase tracking-widest text-xs text-white mb-2">Klubben</p>{meny.klubben.map((m) => <a class="block py-0.5 hover:text-white" href={url(m.url)}>{m.tekst}</a>)}</div>
      <div><p class="uppercase tracking-widest text-xs text-white mb-2">Kontakt</p><a class="block" href={`mailto:${site.epost.post}`}>{site.epost.post}</a><a class="block" href={site.facebook}>Facebook</a><a class="block" href={site.instagram}>Instagram</a></div>
    </div>
  </footer>
</body>
</html>
