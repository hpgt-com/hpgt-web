---
import { forside, url, ekstern, dato, datoKort, tidSted, bildeFor, utdrag, lenke } from "../../lib/site";
const { innlegg, kommende, tidligere } = Astro.props;
const [hoved, ...resten] = innlegg;
const arr = kommende.length ? kommende.slice(0, 4) : tidligere.slice(0, 4);
const kicker = (p) => p.data.kategorier[0];
---
<div class="grid gap-10 lg:grid-cols-3">
  <article class="lg:col-span-2">
    <a href={url(lenke(hoved))} class="group block">
      <img src={url(bildeFor(hoved))} alt="" class="w-full aspect-[16/9] object-cover" />
      <p class="mt-4 text-xs uppercase tracking-widest text-accent font-semibold">{kicker(hoved)} · {dato(hoved.data.date)}</p>
      <h1 class="font-serif font-extrabold text-4xl md:text-5xl leading-tight group-hover:underline decoration-accent">{hoved.data.title}</h1>
      <p class="mt-3 text-lg text-stone-600 dark:text-stone-400">{utdrag(hoved.body, 240)}</p>
    </a>
  </article>
  <aside class="border-t-4 lg:border-t-0 lg:border-l lg:pl-8 border-ink dark:border-stone-700">
    <h2 class="font-serif text-2xl font-semibold mb-4">Siste saker</h2>
    <ol class="divide-y divide-stone-300 dark:divide-stone-700">
      {resten.slice(0, 5).map((p, i) => (
        <li class="py-3 flex gap-3"><span class="font-serif text-3xl font-extrabold text-accent/60 leading-none">{i + 1}</span>
          <a href={url(lenke(p))} class="hover:underline"><span class="block text-xs uppercase tracking-wider text-stone-500">{kicker(p)}</span><span class="font-semibold">{p.data.title}</span></a></li>
      ))}
    </ol>
    <a href={url("/nytt/")} class="inline-block mt-4 text-sm font-semibold text-accent">Arkivet fra 2012 →</a>
  </aside>
</div>

<section class="my-14 -mx-4 md:mx-0 bg-ink text-paper dark:bg-stone-900 grid md:grid-cols-2">
  <img src={url(forside.bilde)} alt={forside.bildetekst} class="w-full h-full object-cover min-h-64" />
  <div class="p-8 md:p-12 self-center">
    <p class="text-xs uppercase tracking-[.25em] text-orange-300">Bli med</p>
    <h2 class="font-serif font-extrabold text-4xl mt-2">{forside.tittel}</h2>
    <p class="mt-4 text-stone-300">{forside.ingress}</p>
    <div class="mt-6 flex flex-wrap gap-3">{forside.knapper.map((k, i) => <a href={url(k.url)} class:list={["px-5 py-2.5 font-semibold", i ? "border border-paper/60" : "bg-accent text-white"]}>{k.tekst}</a>)}</div>
  </div>
</section>

<section class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 border-t border-ink dark:border-stone-700 pt-8">
  {forside.kort.map((k) => (
    <a href={url(k.url)} class="group">
      <img src={url(k.bilde)} alt="" loading="lazy" class="aspect-[4/3] w-full object-cover" />
      <h3 class="font-serif text-2xl font-semibold mt-3 group-hover:text-accent">{k.tittel}{ekstern(k.url) && " ↗"}</h3>
      <p class="text-stone-600 dark:text-stone-400 text-sm mt-1">{k.tekst}</p>
    </a>
  ))}
</section>

<section class="mt-14 grid gap-10 md:grid-cols-2">
  <div>
    <h2 class="font-serif text-2xl font-semibold border-b-4 border-ink dark:border-stone-200 pb-2">Kalender</h2>
    <ul>{arr.map((e) => <li class="py-3 border-b border-stone-300 dark:border-stone-700 flex gap-4"><span class="w-16 shrink-0 font-semibold text-accent">{datoKort(e.data.start)}</span><a href={url(lenke(e))} class="hover:underline"><span class="font-semibold block">{e.data.title}</span><span class="text-sm text-stone-500">{tidSted(e)}</span></a></li>)}</ul>
    <a href={url("/arrangementer/")} class="inline-block mt-3 text-sm font-semibold text-accent">Alle arrangementer →</a>
  </div>
  <div>
    <h2 class="font-serif text-2xl font-semibold border-b-4 border-ink dark:border-stone-200 pb-2">For piloter</h2>
    <ul>{forside.snarveier.map((s) => <li class="py-3 border-b border-stone-300 dark:border-stone-700"><a href={url(s.url)} class="font-semibold hover:text-accent">{s.tekst} →</a></li>)}</ul>
  </div>
</section>
