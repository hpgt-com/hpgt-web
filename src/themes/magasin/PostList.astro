---
import { url, datoKort, lenke } from "../../lib/site";
const { title, ingress, grupper, kategorier, aktiv } = Astro.props;
---
<h1 class="font-serif font-extrabold text-5xl">{title}</h1>
{ingress && <p class="mt-3 text-lg text-stone-600 dark:text-stone-400 max-w-2xl">{ingress}</p>}
<nav class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold uppercase tracking-wider border-y border-ink dark:border-stone-700 py-3" aria-label="Kategorier">
  <a href={url("/nytt/")} class:list={[!aktiv && "text-accent"]}>Alle</a>
  {kategorier.map((k) => <a href={url(`/nytt/kategori/${k.slug}/`)} class:list={["hover:text-accent", aktiv === k.slug && "text-accent"]}>{k.navn} <span class="text-stone-400">{k.poster.length}</span></a>)}
</nav>
<div class="mt-8 grid gap-x-10 md:grid-cols-[8rem_1fr]">
  {grupper.map(([aar, poster]) => (
    <>
      <h2 class="font-serif text-4xl font-extrabold text-accent/70 md:sticky md:top-4 self-start">{aar}</h2>
      <ul class="mb-10">{poster.map((p) => <li class="py-2 border-b border-stone-300 dark:border-stone-700 flex gap-4"><span class="w-16 shrink-0 text-sm text-stone-500">{datoKort(p.data.date)}</span><a href={url(lenke(p))} class="font-semibold hover:underline">{p.data.title}</a></li>)}</ul>
    </>
  ))}
</div>
