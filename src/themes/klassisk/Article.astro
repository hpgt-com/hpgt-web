---
import { url } from "../../lib/site";
const { title, ingress, bilde, meta, kategorier, tilbake } = Astro.props;
---
<div class="container py-4">
  <nav aria-label="Brødsmuler"><ol class="breadcrumb"><li class="breadcrumb-item"><a href={url("/")}>Hjem</a></li>{tilbake && <li class="breadcrumb-item"><a href={tilbake.url}>{tilbake.tekst}</a></li>}<li class="breadcrumb-item active" aria-current="page">{title}</li></ol></nav>
  <div class="row"><div class="col-lg-9">
    <article class="bg-white p-4 p-md-5 rounded shadow-sm">
      {meta && <p class="text-body-secondary small mb-1">{meta}{kategorier && kategorier.map((k) => <span class="badge text-bg-primary ms-2">{k}</span>)}</p>}
      <h1 class="display-6 fw-bold">{title}</h1>
      {ingress && <p class="lead">{ingress}</p>}
      {bilde && <img src={url(bilde)} alt="" class="img-fluid rounded my-3" />}
      <div class="content"><slot /></div>
    </article>
  </div></div>
</div>
