---
import { url, dato, lenke, slug } from "../../lib/site";
const { title, ingress, grupper, kategorier, aktiv } = Astro.props;
---
<div class="container py-5">
  <p class="eyebrow mb-2">Arkiv fra 2012</p>
  <h1 class="h-tight display-5 mb-3">{title}</h1>
  {ingress && <p class="lead text-body-secondary">{ingress}</p>}
  <nav class="nav nav-pills nav-filter gap-2 my-4" aria-label="Kategorier">
    <a class:list={["nav-link", !aktiv && "active"]} href={url("/nytt/")}>Alle</a>
    {kategorier.map((k) => <a class:list={["nav-link", aktiv === k.slug && "active"]} data-kat={k.slug} href={url(`/nytt/kategori/${k.slug}/`)}>{k.navn} <small class="font-monospace opacity-75">{k.poster.length}</small></a>)}
  </nav>
  {grupper.map(([aar, poster]) => (
    <section class="mb-4"><h2 class="h-tight fs-2 mt-4">{aar}</h2>
      <div class="list-group list-group-flush list-events border-top">{poster.map((p) => <a class="list-group-item list-group-item-action d-md-flex gap-3 py-2" href={url(lenke(p))}><span class="text-body-secondary small">{dato(p.data.date)}</span><span class="flex-grow-1 d-block">{p.data.title}</span><span class="kat meta-mono" data-kat={slug(p.data.kategorier[0])}>{p.data.kategorier[0]}</span></a>)}</div>
    </section>
  ))}
</div>
