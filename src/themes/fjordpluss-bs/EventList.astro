---
import { url, dato, sted, tid, lenke, arrangementerPaaAar } from "../../lib/site";
const { kommende, tidligere } = Astro.props;
const aar = arrangementerPaaAar(tidligere);
---
<div class="container py-5">
  <p class="eyebrow mb-2">Kalender</p>
  <h1 class="h-tight display-5 mb-3">Arrangementer</h1>
  <p class="lead text-body-secondary">Kurs, sikkerhetsdager, årsmøter og sosiale treff – helt tilbake til 2018.</p>
  <nav class="nav nav-pills nav-filter gap-2 my-4" aria-label="Hopp til år">
    <a class="nav-link" href="#kommende">Kommende <small class="font-monospace opacity-75">{kommende.length}</small></a>
    {aar.map(([a, liste]) => <a class="nav-link" href={`#ar-${a}`}>{a} <small class="font-monospace opacity-75">{liste.length}</small></a>)}
  </nav>
  <section class="mb-4" id="kommende"><h2 class="h-tight fs-2 mt-4">Kommende</h2>
    {kommende.length === 0 ? <div class="alert alert-light border">Ingen nye arrangementer er lagt inn ennå. Følg med i Facebook-gruppa.</div> :
      <div class="list-group list-group-flush list-events border-top"><div class="list-group-item ev-row ev-head py-2" aria-hidden="true"><span>Dato</span><span>Arrangement</span><span>Sted</span><span>Tid</span></div>{kommende.map((e) => <a class="list-group-item list-group-item-action ev-row py-2" href={url(lenke(e))}><span class="text-body-secondary small">{dato(e.data.start)}</span><span class="ev-t">{e.data.title}</span><span class="text-body-secondary small">{sted(e) || "–"}</span><span class="text-body-secondary small text-end">{tid(e)}</span></a>)}</div>}
  </section>
  {aar.map(([a, liste]) => (
    <section class="mb-4" id={`ar-${a}`}><h2 class="h-tight fs-2 mt-4">{a}</h2>
      <div class="list-group list-group-flush list-events border-top"><div class="list-group-item ev-row ev-head py-2" aria-hidden="true"><span>Dato</span><span>Arrangement</span><span>Sted</span><span>Tid</span></div>{liste.map((e) => <a class="list-group-item list-group-item-action ev-row py-2" href={url(lenke(e))}><span class="text-body-secondary small">{dato(e.data.start)}</span><span class="ev-t">{e.data.title}</span><span class="text-body-secondary small">{sted(e) || "–"}</span><span class="text-body-secondary small text-end">{tid(e)}</span></a>)}</div>
    </section>
  ))}
</div>
