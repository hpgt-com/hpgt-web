---
import Head from "../../components/Head.astro";
import ProtoBanner from "../../components/ProtoBanner.astro";
import "../../components/proto.css";
import "./style.css";
import { site, meny, url, ekstern } from "../../lib/site";
const { title, description, image } = Astro.props;
const here = Astro.url.pathname;
const aktiv = (u: string) => !ekstern(u) && here.startsWith(url(u));
---
<!doctype html>
<html lang="nb">
<head><Head title={title} description={description} image={image} /></head>
<body>
  <a class="skip" href="#innhold">Hopp til innhold</a>
  <ProtoBanner navn="8 · Fjord+ (Bootstrap 5)" />
  <nav class="navbar navbar-expand-md border-bottom py-2" aria-label="Hovedmeny">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href={url("/")}>
        <img src={url("/assets/img/hpgt-logo.png")} alt="" width="36" height="36" />
        <span><b class="d-block fs-5 fw-bolder lh-1">HPGT</b><small>Harstad Hang og Paragliderklubb</small></span>
      </a>
      <button class="navbar-toggler" type="button" data-menu-button aria-controls="nav" aria-expanded="false">Meny</button>
      <div class="collapse navbar-collapse justify-content-end" id="nav">
        <div class="navbar-nav">
          {meny.hoved.map((m) => <a class:list={["nav-link", aktiv(m.url) && "active"]} href={url(m.url)}>{m.tekst}{ekstern(m.url) && " ↗"}</a>)}
        </div>
      </div>
    </div>
  </nav>
  <main id="innhold"><slot /></main>
  <footer class="site-foot border-top pt-4 pb-3">
    <div class="container">
      <div class="row g-4">
        <div class="col-6 col-md-4"><p class="h-tight fs-4 mb-1">HPGT</p><p class="text-body-secondary small">Harstad Hang og Paragliderklubb<br />Org.nr. {site.orgnr} · Vipps {site.vipps}</p></div>
        <div class="col-6 col-md"><h2 class="fs-6 fw-bolder">Klubben</h2><ul class="list-unstyled small">{meny.klubben.map((m) => <li><a class="link-secondary link-underline-opacity-0 link-underline-opacity-100-hover" href={url(m.url)}>{m.tekst}</a></li>)}</ul></div>
        <div class="col-6 col-md"><h2 class="fs-6 fw-bolder">For piloter</h2><ul class="list-unstyled small">{meny.piloter.map((m) => <li><a class="link-secondary link-underline-opacity-0 link-underline-opacity-100-hover" href={url(m.url)}>{m.tekst}{ekstern(m.url) && " ↗"}</a></li>)}</ul></div>
        <div class="col-6 col-md"><h2 class="fs-6 fw-bolder">Følg oss</h2><ul class="list-unstyled small"><li><a class="link-secondary link-underline-opacity-0" href={site.facebook}>Facebook ↗</a></li><li><a class="link-secondary link-underline-opacity-0" href={site.instagram}>Instagram ↗</a></li><li><a class="link-secondary link-underline-opacity-0" href={`mailto:${site.epost.post}`}>{site.epost.post}</a></li></ul></div>
      </div>
      <div class="d-flex flex-wrap justify-content-between gap-2 border-top mt-4 pt-3 small">
        <p class="m-0 fst-italic">«{site.sitat.tekst}» <span class="fst-normal text-body-secondary">– {site.sitat.kilde}</span></p><p class="m-0 text-body-secondary">Ingen sporing eller informasjonskapsler.</p>
      </div>
    </div>
  </footer>
</body>
</html>
