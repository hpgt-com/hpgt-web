---
import { url, slug } from "../../lib/site";
const { title, ingress, bilde, meta, kategorier, tilbake } = Astro.props;
---
<article class="container py-5">
  <div class="row"><div class="col-lg-8">
    <nav aria-label="Brødsmuler"><ol class="breadcrumb"><li class="breadcrumb-item"><a href={url("/")}>Hjem</a></li>{tilbake && <li class="breadcrumb-item"><a href={tilbake.url}>{tilbake.tekst}</a></li>}</ol></nav>
    {meta && <p class="meta-mono mb-2">{kategorier?.map((k) => <><a class="kat" data-kat={slug(k)} href={url(`/nytt/kategori/${slug(k)}/`)}>{k}</a> · </>)}{meta}</p>}
    <h1 class="h-tight display-5 mb-3">{title}</h1>
    {ingress && <p class="lead text-body-secondary">{ingress}</p>}
    {bilde && <img class="img-fluid my-4" src={url(bilde)} alt="" />}
    <div class="content"><slot /></div>
  </div></div>
</article>
