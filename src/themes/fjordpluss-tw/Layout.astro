---
import Head from "../../components/Head.astro";
import ProtoBanner from "../../components/ProtoBanner.astro";
import "../../components/proto.css";
import "./style.css";
import { site, meny, url, ekstern } from "../../lib/site";
const { title, description, image } = Astro.props;
const here = Astro.url.pathname;
const aktiv = (u: string) => !ekstern(u) && here.startsWith(url(u));
const fotLenke = "text-[0.8rem] text-muted no-underline hover:text-ink hover:underline";
---
<!doctype html>
<html lang="nb">
<head><Head title={title} description={description} image={image} /></head>
<body>
  <a class="skip" href="#innhold">Hopp til innhold</a>
  <ProtoBanner navn="7 · Fjord+ (Tailwind CSS)" />
  <header class="border-b border-line">
    <div class="mx-auto flex min-h-15 w-[min(1000px,100%-32px)] flex-wrap items-center gap-5">
      <a class="mr-auto flex items-center gap-2 text-ink no-underline" href={url("/")}>
        <img src={url("/assets/img/hpgt-logo.png")} alt="" width="36" height="36" />
        <span><b class="block text-[1.3rem] leading-none font-extrabold tracking-tighter">HPGT</b><small class="font-mono text-[0.55rem] font-semibold uppercase tracking-[0.12em] text-muted">Harstad Hang og Paragliderklubb</small></span>
      </a>
      <button class="hidden rounded border-[1.5px] border-ink px-3 py-1.5 text-sm font-bold max-md:[.js_&]:block" type="button" data-menu-button aria-expanded="false" aria-controls="nav">Meny</button>
      <nav id="nav" class="navlinks flex gap-5 max-md:w-full max-md:flex-col max-md:gap-0 max-md:pb-2" aria-label="Hovedmeny">
        {meny.hoved.map((m) => <a href={url(m.url)} class:list={["border-b-2 py-1.5 text-[0.92rem] font-bold text-ink no-underline hover:border-sky max-md:border-b max-md:border-line max-md:py-2.5", aktiv(m.url) ? "border-sky" : "border-transparent"]}>{m.tekst}{ekstern(m.url) && " ↗"}</a>)}
      </nav>
    </div>
  </header>
  <main id="innhold"><slot /></main>
  <footer class="border-t border-line pt-7.5 pb-5 text-[0.82rem]">
    <div class="mx-auto grid w-[min(1000px,100%-32px)] grid-cols-2 gap-7 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div><p class="m-0 mb-1 text-[1.4rem] font-extrabold tracking-tighter">HPGT</p><p class="text-muted">Harstad Hang og Paragliderklubb<br />Org.nr. {site.orgnr} · Vipps {site.vipps}</p></div>
      <nav class="grid content-start gap-1" aria-label="Klubben"><h2 class="m-0 mb-2 text-[0.78rem] font-extrabold">Klubben</h2>{meny.klubben.map((m) => <a class={fotLenke} href={url(m.url)}>{m.tekst}</a>)}</nav>
      <nav class="grid content-start gap-1" aria-label="For piloter"><h2 class="m-0 mb-2 text-[0.78rem] font-extrabold">For piloter</h2>{meny.piloter.map((m) => <a class={fotLenke} href={url(m.url)}>{m.tekst}{ekstern(m.url) && " ↗"}</a>)}</nav>
      <nav class="grid content-start gap-1" aria-label="Følg oss"><h2 class="m-0 mb-2 text-[0.78rem] font-extrabold">Følg oss</h2><a class={fotLenke} href={site.facebook}>Facebook ↗</a><a class={fotLenke} href={site.instagram}>Instagram ↗</a><a class={fotLenke} href={`mailto:${site.epost.post}`}>{site.epost.post}</a></nav>
    </div>
    <div class="mx-auto mt-6 flex w-[min(1000px,100%-32px)] flex-wrap justify-between gap-3 border-t border-line pt-3.5 text-[0.74rem]">
      <p class="m-0 italic">«{site.sitat.tekst}» <span class="not-italic text-muted">– {site.sitat.kilde}</span></p><p class="m-0 text-muted">Ingen sporing eller informasjonskapsler.</p>
    </div>
  </footer>
</body>
</html>
