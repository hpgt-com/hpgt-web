---
import VisningsValg from "../../components/VisningsValg.astro";
import Kortnett from "../../components/Kortnett.astro";
import { url, dato, sted, tid, lenke, arrangementerPaaAar } from "../../lib/site";
const { kommende, tidligere } = Astro.props;
const aar = arrangementerPaaAar(tidligere);
const chip = "border border-line bg-surface px-[11px] py-1.5 text-[0.88rem] font-bold text-ink no-underline hover:border-sky";
const rad = "group grid grid-cols-[150px_minmax(0,1fr)_190px_90px] items-baseline gap-x-3.5 gap-y-1 border-b border-line px-0.5 py-2.5 text-ink no-underline max-sm:grid-cols-[1fr_auto]";
const hode = "grid grid-cols-[150px_minmax(0,1fr)_190px_90px] gap-x-3.5 border-b border-line px-0.5 pt-2 pb-1.5 font-mono text-[0.62rem] font-semibold uppercase tracking-[0.12em] text-muted max-sm:hidden";
---
<div class="mx-auto w-[min(1000px,100%-32px)] py-14">
  <p class="eyebrow mb-2">Kalender</p>
  <h1 class="m-0 mb-3.5 text-[clamp(2.4rem,6vw,3.8rem)] leading-[0.95] font-extrabold tracking-[-0.045em]">Arrangementer</h1>
  <p class="max-w-[60ch] text-[1.15rem] text-muted">Kurs, sikkerhetsdager, årsmøter og sosiale treff – helt tilbake til 2018.</p>
  <nav class="mt-5.5 mb-2 flex flex-wrap gap-1.5" aria-label="Hopp til år">
    <a class={chip} href="#kommende">Kommende <small class="font-mono text-muted">{kommende.length}</small></a>
    {aar.map(([a, liste]) => <a class={chip} href={`#ar-${a}`}>{a} <small class="font-mono text-muted">{liste.length}</small></a>)}
  </nav>
  <VisningsValg />
  <section class="scroll-mt-4" id="kommende"><h2 class="mt-8.5 mb-1.5 text-[1.8rem] font-extrabold tracking-[-0.04em]">Kommende</h2>
    {kommende.length === 0 ? <p class="text-muted">Ingen nye arrangementer er lagt inn ennå. Følg med i Facebook-gruppa.</p> :
      <ul class="m-0 list-none border-t border-line p-0" data-visning="liste"><li class={hode} aria-hidden="true"><span>Dato</span><span>Arrangement</span><span>Sted</span><span class="text-right">Tid</span></li>{kommende.map((e) => <li><a class={rad} href={url(lenke(e))}><time class="text-[0.88rem] text-muted tabular-nums max-sm:col-span-full">{dato(e.data.start)}</time><span class="group-hover:text-sky-ink max-sm:col-span-full">{e.data.title}</span><span class="text-[0.88rem] text-muted">{sted(e) || "–"}</span><span class="text-right text-[0.88rem] text-muted tabular-nums">{tid(e)}</span></a></li>)}</ul>}
    {kommende.length > 0 && <Kortnett arrangementer={kommende} />}
  </section>
  {aar.map(([a, liste]) => (
    <section class="scroll-mt-4" id={`ar-${a}`}><h2 class="mt-8.5 mb-1.5 text-[1.8rem] font-extrabold tracking-[-0.04em]">{a}</h2>
      <ul class="m-0 list-none border-t border-line p-0" data-visning="liste"><li class={hode} aria-hidden="true"><span>Dato</span><span>Arrangement</span><span>Sted</span><span class="text-right">Tid</span></li>{liste.map((e) => <li><a class={rad} href={url(lenke(e))}><time class="text-[0.88rem] text-muted tabular-nums max-sm:col-span-full">{dato(e.data.start)}</time><span class="group-hover:text-sky-ink max-sm:col-span-full">{e.data.title}</span><span class="text-[0.88rem] text-muted">{sted(e) || "–"}</span><span class="text-right text-[0.88rem] text-muted tabular-nums">{tid(e)}</span></a></li>)}</ul>
      <Kortnett arrangementer={liste} />
    </section>
  ))}
</div>
