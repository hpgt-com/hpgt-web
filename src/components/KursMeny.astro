---
// Egen meny for kursene, øverst på /kurs/ og på hver kursside. Nye kurssider (Pages CMS → Kurs) dukker opp her automatisk.
import { hentKurs, kursLenke, url } from "../lib/site";
import "./kurs.css";
const here = Astro.url.pathname;
const lenker = [{ tekst: "Alle kurs", href: url("/kurs/") }, ...(await hentKurs()).map((k) => ({ tekst: k.data.menynavn ?? k.data.title, href: url(kursLenke(k)) }))];
---
<nav class="kursmeny" aria-label="Kurs">
  {lenker.map((l) => <a href={l.href} aria-current={here === l.href ? "page" : undefined}>{l.tekst}</a>)}
</nav>
