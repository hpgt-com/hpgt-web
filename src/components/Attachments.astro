---
import { url } from "../lib/site";
import { pageInfo } from "../lib/i18n";
const en = pageInfo(Astro.url.pathname).lang === "en";
// files: attachments-feltet i innlegget (title og file er feltnavn i Pages CMS)
const { files } = Astro.props as { files: { title: string; file: string }[] };
---
<section class="attachments" aria-label={en ? "Attachments" : "Vedlegg"}>
  <h2>{en ? "Attachments" : "Vedlegg"}</h2>
  <ul>{files.map((f) => <li><a href={url(f.file)} download>{f.title}</a></li>)}</ul>
</section>
