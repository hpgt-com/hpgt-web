---
// Filtrer kalenderen på gruppe: Kurs, Fagdag, Møte, Sosialt, Konkurranse. Skjult uten JavaScript.
import { gruppe, url, GRUPPER, type Arrangement } from "../lib/site";
import { sideInfo, gruppeNavn } from "../lib/i18n";
import "./kort.css";
import "./typefarger.css";
const { alle } = Astro.props as { alle: Arrangement[] };
const { sprak } = sideInfo(Astro.url.pathname);
const grupper = GRUPPER.map((g) => ({ ...g, antall: alle.filter((e) => gruppe(e) === g.slug).length }));
---
<div class="typefilter" role="group" aria-label={sprak === "en" ? "Show type" : "Vis type"} hidden>
  <button type="button" data-filter="" aria-pressed="true">{sprak === "en" ? "All" : "Alle"} <small>{alle.length}</small></button>
  {grupper.map((g) => <button type="button" data-filter={g.slug} data-kat={g.slug} aria-pressed="false" disabled={g.antall === 0}>{gruppeNavn(sprak, g.navn)} <small>{g.antall}</small></button>)}
</div>
<script is:inline src={url("/assets/js/typefilter.js")} defer></script>
