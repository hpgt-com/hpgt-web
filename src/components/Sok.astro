---
// Søkeside: skjema og resultatliste. Søket gjøres av public/assets/js/sok.js mot /sok.json (ingen eksterne tjenester).
import { url } from "../lib/site";
import { sideInfo } from "../lib/i18n";
const { sprak } = sideInfo(Astro.url.pathname);
const en = sprak === "en";
---
<form class="sok" role="search" data-sok data-base={import.meta.env.BASE_URL.replace(/\/$/, "")} action={url(en ? "/en/sok/" : "/sok/")} method="get">
  <label for="sok-felt" class="sok__etikett">{en ? "Search the site" : "Søk på siden"}</label>
  <div class="sok__rad">
    <input id="sok-felt" type="search" name="q" autocomplete="off" placeholder={en ? "E.g. course, tandem, NOTAM …" : "F.eks. kurs, tandem, NOTAM, årsmøte …"} />
    <button type="submit" class="btn">{en ? "Search" : "Søk"}</button>
  </div>
</form>
<p class="sok__status" data-sok-status aria-live="polite"></p>
<ol class="sok__resultat" data-sok-resultat></ol>
<noscript><p>{en ? "Search requires JavaScript." : "Søket krever JavaScript."}</p></noscript>
<script is:inline src={url("/assets/js/sok.js")} defer></script>
