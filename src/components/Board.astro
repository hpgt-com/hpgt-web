---
// Rekkefølgen i board.json (redigeres i CMS-et) bestemmer rekkefølgen på siden. id brukes som anker, f.eks. /klubben/styret/#faglig-leder.
import "./board.css";
import { url } from "../lib/site";
import { T, pageInfo, boardFor } from "../lib/i18n";
const { lang } = pageInfo(Astro.url.pathname);
const t = T[lang];
const board = boardFor(lang);
---
<ul class="people" aria-label={t.board}>
  {board.members.map((p) => (
    <li class="person" id={p.id}>
      {p.image && <img src={url(p.image)} alt={`${t.portrait} ${p.name}`} width="160" height="160" loading="lazy" />}
      <div>
        <p class="person__role">{p.role}</p>
        <p class="person__name">{p.name}</p>
        {"responsibility" in p && p.responsibility && <p class="person__responsibility"><b>{t.contactMe}</b> {p.responsibility}</p>}
        {p.phone && <p><a href={`tel:${p.phone.replace(/\s/g, "")}`}>{p.phone}</a></p>}
        {"email" in p && p.email && <p><a href={`mailto:${p.email}`}>{p.email}</a></p>}
      </div>
    </li>
  ))}
</ul>
