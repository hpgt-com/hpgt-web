---
// Kort for hver kursside på /kurs/
import { hentKurs, kursLenke, url } from "../lib/site";
import { T, sideInfo } from "../lib/i18n";
import "./kurs.css";
const { sprak } = sideInfo(Astro.url.pathname);
const kurs = await hentKurs(sprak);
const p = sprak === "en" ? "/en" : "";
---
{kurs.length > 0 && <section class="kurskort" aria-labelledby="kurskort-h">
  <h2 id="kurskort-h">{T[sprak].kursene}</h2>
  <ul>{kurs.map((k) => <li><a href={url(p + kursLenke(k))}>
    {k.data.bilde && <img src={url(k.data.bilde)} alt="" loading="lazy" />}
    <b>{k.data.title}</b>{k.data.ingress && <span>{k.data.ingress}</span>}</a></li>)}</ul>
</section>}
