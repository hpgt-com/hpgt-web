---
// Knapperad øverst på alle sider i en seksjon (Kurs, For piloter, Klubben). Ingen nedtrekksmenyer – se src/lib/seksjoner.ts.
import { sideInfo, menyTekst, engelskeStier } from "../lib/i18n";
import { seksjonFor, aktivLenke, seksjonsHref } from "../lib/seksjoner";
import "./kurs.css";
const { sti, sprak } = sideInfo(Astro.url.pathname);
const s = await seksjonFor(sti, sprak);
const engelske = await engelskeStier();
const aktiv = s && aktivLenke(s, sti);
const lenk = (u: string) => (s ? seksjonsHref(s, u, sprak, engelske) : u);
---
{s && <nav class="kursmeny" aria-label={menyTekst(sprak, s.tekst)}>
  <a href={lenk(s.url)} aria-current={aktiv === s.url ? "page" : undefined}>{menyTekst(sprak, s.forste)}</a>
  {s.sider.map((l) => <a href={lenk(l.url)} aria-current={aktiv === l.url ? "page" : undefined}>{s.url === "/kurs/" ? l.tekst : menyTekst(sprak, l.tekst)}{l.ekstern && " ↗"}</a>)}
</nav>}
