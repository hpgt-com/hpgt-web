---
import Pil from "./Pil.astro";
// Faktaboks øverst i et innlegg som også er et arrangement: når, hvor (fysisk eller nettmøte), type og påmelding.
import { url, gruppeFor } from "../lib/site";
import { sideInfo, fmtFor, typeTekstFor } from "../lib/i18n";
import "./arrangement.css";
import "./typefarger.css";
const { a } = Astro.props;
const { sprak } = sideInfo(Astro.url.pathname);
const en = sprak === "en";
const { dato, klokke } = fmtFor(sprak);
const start: Date = a.start, slutt: Date | undefined = a.slutt;
const sammeDag = !slutt || start.toISOString().slice(0, 10) === slutt.toISOString().slice(0, 10);
const naar = sammeDag ? dato(start) : `${dato(start).replace(/ \d{4}$/, "")} – ${dato(slutt!)}`;
const tid = a.heldag ? (en ? "All day" : "Hele dagen") : `${en ? "" : "kl. "}${klokke(start)}${slutt && sammeDag ? "–" + klokke(slutt) : ""}`;
const ferdig = +(slutt ?? start) < Date.now();
---
<aside class="arr" aria-label={en ? "About the event" : "Om arrangementet"}>
  <dl>
    <div><dt>{en ? "When" : "Når"}</dt><dd>{naar}<br /><span class="arr__tid">{tid}</span></dd></div>
    <div><dt>{en ? "Where" : "Hvor"}</dt><dd>{a.sted ?? (a.digital ? (en ? "Online" : "Digitalt") : (en ? "To be announced" : "Kommer"))}{a.digital && <><br /><a href={a.digital}>{en ? "Join online" : "Bli med på nett"}&nbsp;<Pil /></a></>}</dd></div>
    <div><dt>{en ? "Organiser" : "Arrangør"}</dt><dd>{a.arrangor ?? "HPGT"}</dd></div>
    <div><dt>Type</dt><dd><span class="arr__type kat" data-kat={gruppeFor(a.type).slug}>{typeTekstFor(sprak, a.type)}</span></dd></div>
  </dl>
  {a.pamelding && !ferdig && <a class="arr__knapp" href={url(a.pamelding)}>{en ? "Sign up" : "Meld deg på"}</a>}
  {ferdig && <p class="arr__ferdig">{en ? "This event has taken place." : "Dette arrangementet er gjennomført."}</p>}
</aside>
