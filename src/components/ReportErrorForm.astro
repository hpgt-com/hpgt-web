---
// «Meld feil»: sendes til /api/meld-feil (worker/index.js), som sjekker Turnstile og lager en sak med etiketten
// «feedback» i det private repoet hpgt-com/form-submissions (via GitHub-appen «HPGT Web Forms»). Siden fylles ut fra
// ?side= (lenken i bunnen av hver side). Turnstile-nøkkelen byttes ved publisering, som for RadioID-skjemaet.
// Feltnavnene (name=…), ?sprak=en og ?side= leses av workeren og form.js, og beholdes.
import { site, url } from "../lib/site";
import "./form.css";
interface Props { lang?: "nb" | "en" }
const { lang = "nb" } = Astro.props;
const demo = site.prototype;
const T = {
  nb: {
    info: "Meldingen blir en sak i et lukket arkiv som bare de som vedlikeholder nettsiden kan lese. Navn eller e-post trenger du bare å oppgi hvis du vil ha svar.",
    page: "Hvilken side gjelder det?", pageHelp: "Fylles ut av seg selv når du kommer fra lenken nederst på en side. La stå tom hvis det gjelder hele nettsiden.",
    message: "Hva er feil eller mangler?", contact: "Navn eller e-post, hvis du vil ha svar", optional: "(valgfritt)",
    send: "Send", sending: "Sender …", networkError: "Fikk ikke kontakt. Sjekk nettet og prøv igjen.",
    demo: "Her kommer Cloudflare Turnstile – en usynlig «er du et menneske?»-sjekk uten bildegåter eller sporing.",
  },
  en: {
    info: "Your message becomes an issue in a closed archive that only the people who maintain the website can read. You only need to give your name or e-mail if you would like a reply.",
    page: "Which page is it about?", pageHelp: "Filled in for you when you come from the link at the bottom of a page. Leave it empty if it is about the whole website.",
    message: "What is wrong or missing?", contact: "Name or e-mail, if you would like a reply", optional: "(optional)",
    send: "Send", sending: "Sending …", networkError: "Could not connect. Check your connection and try again.",
    demo: "Cloudflare Turnstile goes here – an invisible “are you human?” check without image puzzles or tracking.",
  },
}[lang];
---
<section class="form" aria-label={lang === "en" ? "Report an error" : "Meld feil"}>
  <p class="form__info">{T.info}</p>
  <form class="form__fields" method="post" action={lang === "en" ? "/api/meld-feil?sprak=en" : "/api/meld-feil"} data-sending={T.sending} data-network-error={T.networkError} data-demo={demo ? "" : undefined}>
    <div><label for="re-page">{T.page} <span class="form__optional">{T.optional}</span></label>
      <input id="re-page" name="side" maxlength="200" pattern="\/[A-Za-z0-9\/._~%\-]*" spellcheck="false" placeholder="/kurs/" aria-describedby="re-page-help" data-from-url />
      <small id="re-page-help">{T.pageHelp}</small></div>
    <div><label for="re-message">{T.message}</label>
      <textarea id="re-message" name="melding" required minlength="5" maxlength="2000" rows="6"></textarea></div>
    <div><label for="re-contact">{T.contact} <span class="form__optional">{T.optional}</span></label>
      <input id="re-contact" name="kontakt" maxlength="100" autocomplete="email" /></div>
    <div class="form__hp" aria-hidden="true"><label>Nettside <input name="nettside" tabindex="-1" autocomplete="off" /></label></div>
    {demo
      ? <p class="form__turnstile">{T.demo}</p>
      : <div class="cf-turnstile" data-sitekey={site.turnstile} data-action="meldfeil" data-language={lang === "en" ? "en" : "nb"}></div>}
    <div class="form__submit"><button type="submit">{T.send}</button><p class="form__status" role="status" aria-live="polite"></p></div>
    <pre class="form__demo" hidden></pre>
  </form>
</section>
{!demo && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script is:inline src={url("/assets/js/form.js")} defer></script>
