---
import Pil from "./Pil.astro";
// Kort for hver underside på oversiktssiden til For piloter og Klubben (samme utseende som kurskortene)
import { url } from "../lib/site";
import { sideInfo, menyTekst, engelskeStier, lenkeFor } from "../lib/i18n";
import { seksjonFor } from "../lib/seksjoner";
import "./kurs.css";
const { sti, sprak } = sideInfo(Astro.url.pathname);
const s = await seksjonFor(sti, sprak);
const engelske = await engelskeStier();
const lenk = (u: string) => lenkeFor(sprak, u, engelske);
---
{s && s.url !== "/kurs/" && <section class="kurskort" aria-labelledby="seksjon-h">
  <h2 id="seksjon-h">{sprak === "en" ? "In this section" : "I denne delen"}</h2>
  <ul>{s.sider.map((l) => <li><a href={lenk(l.url)}>
    {l.bilde && <img src={url(l.bilde)} alt="" loading="lazy" />}
    <b>{menyTekst(sprak, l.tekst)}{l.ekstern && <> <Pil /></>}</b>{l.ingress && <span>{l.ingress}</span>}</a></li>)}</ul>
</section>}
