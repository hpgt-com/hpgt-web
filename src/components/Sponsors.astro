---
// Sponsorstripen over bunnen på alle sidene. Sponsorene står i src/data/sponsors.json (Pages CMS: «Sponsorer»).
// Uten aktive sponsorer vises ingenting. På forsiden vises bare de som ikke allerede står i båndet der (FrontSponsors.astro).
import SponsorList from "./SponsorList.astro";
import { activeSponsors } from "../lib/sponsors";
import { T, type Lang } from "../lib/i18n";
const { lang, front = false } = Astro.props as { lang: Lang; front?: boolean };
const t = T[lang];
const sponsors = (await activeSponsors()).filter((s) => !(front && s.frontPage));
---
{sponsors.length > 0 && (
  <section class="sponsors" aria-labelledby="sponsors-title">
    <div class="wrap">
      <h2 id="sponsors-title" class="sponsors__title">{t.sponsors}</h2>
      <SponsorList sponsors={sponsors} lang={lang} />
    </div>
  </section>
)}
