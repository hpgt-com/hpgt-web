---
// Felles <head> for alle design: streng CSP (kun egne filer, ingen sporing), noindex mens dette er en prototype.
import { site, url } from "../lib/site";
import { tilEngelsk } from "../lib/engelske-adresser.mjs";
// Skriftene lastes før første tegning, så teksten ikke hopper når de kommer (Lighthouse: layout shift). Bare latin;
// samme filer som @fontsource-importene i Layout.astro, så nettleseren henter dem bare én gang.
import interTight from "@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url";
import plexMono600 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url";
interface Props { title: string; description?: string; image?: string; sprak?: "nb" | "en"; sti?: string; alternativ?: boolean; noindex?: boolean }
const { title, description = site.beskrivelse, image, sprak = "nb", sti: normalSti, alternativ = false, noindex = false } = Astro.props;
// Begge språkversjonene peker på hverandre (hreflang), så søkemotorer viser riktig språk
const nbUrl = normalSti && new URL(normalSti, site.url);
const enUrl = normalSti && new URL(`/en${tilEngelsk(normalSti)}`, site.url);
const fullTitle = title === site.navn ? site.navn : `${title} – ${site.kortnavn}`;
// Sider med skjema får laste Cloudflare Turnstile – ingen andre. Må stemme med public/_headers.
const SKJEMASIDER = ["/for-piloter/radioid/", "/meld-feil/", "/en/report-error/"];
const sti = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "");
const turnstile = !site.prototype && SKJEMASIDER.includes(sti);
const cf = "https://challenges.cloudflare.com";
// Videoer spilles av i overlay (public/assets/js/galleri.js) først når noen trykker – bare fra disse to. Må stemme med public/_headers.
const VIDEO = "https://www.youtube-nocookie.com https://player.vimeo.com";
// Anonym besøksstatistikk (Cloudflare Web Analytics): ingen informasjonskapsler, ingen sporing mellom nettsteder.
// Slås på med tokenet i site.json → statistikk. Uten token lastes ingenting. Må stemme med public/_headers.
const statistikk = site.statistikk;
const CFA_SKRIPT = "https://static.cloudflareinsights.com", CFA_DATA = "https://cloudflareinsights.com";
const csp = `default-src 'self'; script-src 'self'${turnstile ? " " + cf : ""}${statistikk ? " " + CFA_SKRIPT : ""}; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'${statistikk ? " " + CFA_DATA : ""}; frame-src ${turnstile ? cf + " " : ""}${VIDEO}; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests`;
const canonical = new URL(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), ""), site.url);
---
<meta charset="utf-8" />
<link rel="preload" href={interTight} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={plexMono600} as="font" type="font/woff2" crossorigin />
<meta http-equiv="Content-Security-Policy" content={csp} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{(site.prototype || noindex) && <meta name="robots" content="noindex, nofollow" />}
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:site_name" content={site.navn} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={sprak === "en" ? "en_GB" : "nb_NO"} />
{alternativ && nbUrl && <><link rel="alternate" hreflang="nb" href={nbUrl} /><link rel="alternate" hreflang="en" href={enUrl} /><link rel="alternate" hreflang="x-default" href={nbUrl} /></>}
{/* Delingsbilde: sidens eget bilde, ellers klubbens standardbilde (site.json → delingsbilde) */}
<meta property="og:image" content={new URL(image ?? site.delingsbilde, site.url)} />
<link rel="icon" href={url("/favicon.ico")} sizes="any" />
<link rel="icon" href={url("/assets/img/hpgt-logo.png")} type="image/png" />
<link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
<script is:inline src={url("/assets/js/tema.js")}></script>
<script is:inline src={url("/assets/js/meny.js")} defer></script>
<script is:inline src={url("/assets/js/innhold.js")} defer></script>
<script is:inline src={url("/assets/js/kopier.js")} defer></script>
<script is:inline src={url("/assets/js/galleri.js")} defer></script>
{statistikk && <script is:inline defer src={`${CFA_SKRIPT}/beacon.min.js`} data-cf-beacon={JSON.stringify({ token: statistikk })}></script>}
