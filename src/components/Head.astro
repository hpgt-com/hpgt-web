---
// Felles <head> for alle design: streng CSP (kun egne filer, ingen sporing), noindex mens dette er en prototype.
import { site, url } from "../lib/site";
interface Props { title: string; description?: string; image?: string; sprak?: "nb" | "en"; sti?: string; alternativ?: boolean }
const { title, description = site.beskrivelse, image, sprak = "nb", sti: normalSti, alternativ = false } = Astro.props;
// Begge språkversjonene peker på hverandre (hreflang), så søkemotorer viser riktig språk
const nbUrl = normalSti && new URL(normalSti, site.url);
const enUrl = normalSti && new URL(`/en${normalSti}`, site.url);
const fullTitle = title === site.navn ? site.navn : `${title} – ${site.kortnavn}`;
// Sider med skjema får laste Cloudflare Turnstile – ingen andre. Må stemme med public/_headers.
const SKJEMASIDER = ["/flysteder/flarm-fanet-radioid/"];
const sti = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "");
const turnstile = !site.prototype && SKJEMASIDER.includes(sti);
const cf = "https://challenges.cloudflare.com";
const csp = `default-src 'self'; script-src 'self'${turnstile ? " " + cf : ""}; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src ${turnstile ? cf : "'none'"}; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests`;
const canonical = new URL(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), ""), site.url);
---
<meta charset="utf-8" />
<meta http-equiv="Content-Security-Policy" content={csp} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{site.prototype && <meta name="robots" content="noindex, nofollow" />}
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:site_name" content={site.navn} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={sprak === "en" ? "en_GB" : "nb_NO"} />
{alternativ && nbUrl && <><link rel="alternate" hreflang="nb" href={nbUrl} /><link rel="alternate" hreflang="en" href={enUrl} /><link rel="alternate" hreflang="x-default" href={nbUrl} /></>}
{image && <meta property="og:image" content={new URL(image, site.url)} />}
<link rel="icon" href={url("/assets/img/hpgt-logo.png")} />
<script is:inline src={url("/assets/js/tema.js")}></script>
<script is:inline src={url("/assets/js/meny.js")} defer></script>
<script is:inline src={url("/assets/js/innhold.js")} defer></script>
