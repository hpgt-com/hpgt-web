---
// Bytter mellom liste og bildevisning på Nytt og Arrangementer. Skjult uten JavaScript – da vises listen som før.
import { url } from "../lib/site";
import { sideInfo } from "../lib/i18n";
import "./kort.css";
const en = sideInfo(Astro.url.pathname).sprak === "en";
---
<div class="visning" role="group" aria-label={en ? "View" : "Visning"} hidden>
  <button type="button" data-vis="liste" aria-pressed="true"><span aria-hidden="true">☰</span> {en ? "List" : "Liste"}</button>
  <button type="button" data-vis="bilder" aria-pressed="false"><span aria-hidden="true">▦</span> {en ? "Pictures" : "Bilder"}</button>
</div>
<script is:inline src={url("/assets/js/visning.js")} defer></script>
