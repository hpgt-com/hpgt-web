---
// Piler (↗ → ↓ ←) som små vektorikoner i tekstens farge og størrelse. Skrifttypen mangler pilene, så telefoner
// lånte dem fra andre skrifter (iOS: emoji, eller tynne piler i feil størrelse). Nå ser de like ut overalt.
// Samme tegning brukes i public/assets/js/calendar.js.
interface Props { direction?: "out" | "right" | "down" | "left" }
const { direction = "out" } = Astro.props;
const d = {
  out: "M3.5 12.5 12.5 3.5M5 3.5h7.5V11",
  right: "M2.5 8h11M9 3.5 13.5 8 9 12.5",
  down: "M8 2.5v11M3.5 9 8 13.5 12.5 9",
  left: "M13.5 8h-11M7 3.5 2.5 8 7 12.5",
}[direction];
---
<svg class="arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d={d} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
