---
// Standardbilde for innlegg og arrangementer uten eget bilde. Et klubbilde fra src/data/standardbilder.json
// (redigeres i Pages CMS under «Standardbilder»), valgt fra kategoriens liste. Samme innlegg får alltid samme bilde,
// og innleggene fordeles på bildene, så lister ikke viser ett og samme bilde om og om igjen.
// Har kategorien ingen bilder, vises kategoriens farge med et ikon. tekst: kategorien (innlegg) eller datoen (arrangementer).
import { url } from "../lib/site";
import standardbilder from "../data/standardbilder.json";
interface Props { kat?: string; tekst?: string; class?: string; nokkel?: string }
const { kat = "nyhet", tekst, class: klasse, nokkel = "" } = Astro.props;
// Arrangementsgruppene og kategoriene deler bildelister
const LISTE: Record<string, keyof typeof standardbilder> = {
  nyhet: "nyhet", "moter-og-referater": "moter-og-referater", mote: "moter-og-referater",
  "kurs-og-fagdag": "kurs", kurs: "kurs", fagdag: "fagdag",
  "sosialt-og-turer": "sosialt-og-turer", sosialt: "sosialt-og-turer", konkurranser: "konkurranser", konkurranse: "konkurranser",
};
const bilder = (standardbilder[LISTE[kat] ?? "nyhet"] ?? []) as string[];
let h = 0;
for (const c of nokkel) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const foto = Array.isArray(bilder) && bilder.length ? bilder[h % bilder.length] : undefined;
// Ikon etter kategori (innlegg) eller gruppe (arrangementer). Tegnet på et 24×24-rutenett med strek.
const IKON: Record<string, string> = {
  nyhet: "M4 10v4h3l8 4.5V5.5L7 10H4zM18.5 9a4 4 0 0 1 0 6",
  "moter-og-referater": "M7 3h7l4 4v14H7zM14 3v4h4M10 12h5M10 16h5",
  mote: "M7 3h7l4 4v14H7zM14 3v4h4M10 12h5M10 16h5",
  "kurs-og-fagdag": "M3 9.5c3.5-4.5 14.5-4.5 18 0M3 9.5 12 20l9-10.5M8 7.6 12 20l4-12.4",
  kurs: "M3 9.5c3.5-4.5 14.5-4.5 18 0M3 9.5 12 20l9-10.5M8 7.6 12 20l4-12.4",
  fagdag: "M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6zM9 12l2 2 4-4",
  "sosialt-og-turer": "M3 19l6-9 4 6 3-4 5 7zM17 5.5a1.5 1.5 0 1 0 0 .01",
  sosialt: "M3 19l6-9 4 6 3-4 5 7zM17 5.5a1.5 1.5 0 1 0 0 .01",
  konkurranser: "M8 4h8v5a4 4 0 0 1-8 0zM8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4M12 13v4M9 20h6",
  konkurranse: "M8 4h8v5a4 4 0 0 1-8 0zM8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4M12 13v4M9 20h6",
};
const d = IKON[kat] ?? IKON["kurs"];
---
{foto
  ? <span class:list={["standardbilde standardbilde--foto", klasse]} data-kat={kat}>
      <img src={url(foto)} alt="" loading="lazy" decoding="async" />
      {tekst && <span class="standardbilde__etikett">{tekst}</span>}
    </span>
  : <span class:list={["standardbilde", klasse]} data-kat={kat} aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false"><path d={d} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      {tekst && <span>{tekst}</span>}
    </span>}
