---
// Vindrose med åtte sektorer; sektorene der startstedet er flybart er fylt. Data fra flysteder.hpgt.com.
interface Props { retninger: string[]; size?: number; }
const { retninger, size = 44 } = Astro.props;
const R = ["N", "NØ", "Ø", "SØ", "S", "SV", "V", "NV"];
const c = 50, r = 46, ri = 14;
const pt = (deg: number, rad: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return `${(c + rad * Math.cos(a)).toFixed(1)},${(c + rad * Math.sin(a)).toFixed(1)}`;
};
const sektor = (i: number) => {
  const a0 = i * 45 - 22.5, a1 = i * 45 + 22.5;
  return `M${pt(a0, ri)} L${pt(a0, r)} A${r},${r} 0 0 1 ${pt(a1, r)} L${pt(a1, ri)} A${ri},${ri} 0 0 0 ${pt(a0, ri)}Z`;
};
---
<svg class="rose" width={size} height={size} viewBox="0 0 100 100" role="img" aria-label={`Vindretninger: ${retninger.join(", ")}`}>
  {R.map((d, i) => <path d={sektor(i)} class:list={["rose__s", retninger.includes(d) && "rose__s--on"]} />)}
  <text x="50" y="13" text-anchor="middle" class="rose__n">N</text>
</svg>
