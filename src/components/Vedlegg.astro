---
import { url } from "../lib/site";
import { sideInfo } from "../lib/i18n";
const en = sideInfo(Astro.url.pathname).sprak === "en";
const { filer } = Astro.props as { filer: { tittel: string; fil: string }[] };
---
<section class="vedlegg" aria-label={en ? "Attachments" : "Vedlegg"}>
  <h2>{en ? "Attachments" : "Vedlegg"}</h2>
  <ul>{filer.map((f) => <li><a href={url(f.fil)} download>{f.tittel}</a></li>)}</ul>
</section>
