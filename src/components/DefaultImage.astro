---
// Standardbilde for innlegg og arrangementer uten eget bilde. Et klubbilde fra src/data/default-images.json
// (redigeres i Pages CMS under «Standardbilder»), valgt fra kategoriens liste. Samme innlegg får alltid samme bilde,
// og innleggene fordeles på bildene, så lister ikke viser ett og samme bilde om og om igjen.
// Har kategorien ingen bilder, vises kategoriens farge med et ikon. label: kategorien (innlegg) eller datoen (arrangementer).
import { url } from "../lib/site";
import defaultImages from "../data/default-images.json";
interface Props { cat?: string; label?: string; class?: string; seed?: string }
const { cat = "nyhet", label, class: className, seed = "" } = Astro.props;
// Arrangementsgruppene og kategoriene (slug, som også er data-cat) deler bildelister (nøklene i default-images.json)
const LIST: Record<string, keyof typeof defaultImages> = {
  nyhet: "news", "moter-og-referater": "meetings", mote: "meetings",
  "kurs-og-fagdag": "courses", kurs: "courses", fagdag: "trainingDays",
  "sosialt-og-turer": "social", sosialt: "social", konkurranser: "competitions", konkurranse: "competitions",
};
const images = (defaultImages[LIST[cat] ?? "news"] ?? []) as string[];
let h = 0;
for (const c of seed) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const photo = Array.isArray(images) && images.length ? images[h % images.length] : undefined;
// Ikon etter kategori (innlegg) eller gruppe (arrangementer). Tegnet på et 24×24-rutenett med strek.
const ICON: Record<string, string> = {
  nyhet: "M4 10v4h3l8 4.5V5.5L7 10H4zM18.5 9a4 4 0 0 1 0 6",
  "moter-og-referater": "M7 3h7l4 4v14H7zM14 3v4h4M10 12h5M10 16h5",
  mote: "M7 3h7l4 4v14H7zM14 3v4h4M10 12h5M10 16h5",
  "kurs-og-fagdag": "M3 9.5c3.5-4.5 14.5-4.5 18 0M3 9.5 12 20l9-10.5M8 7.6 12 20l4-12.4",
  kurs: "M3 9.5c3.5-4.5 14.5-4.5 18 0M3 9.5 12 20l9-10.5M8 7.6 12 20l4-12.4",
  fagdag: "M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6zM9 12l2 2 4-4",
  "sosialt-og-turer": "M3 19l6-9 4 6 3-4 5 7zM17 5.5a1.5 1.5 0 1 0 0 .01",
  sosialt: "M3 19l6-9 4 6 3-4 5 7zM17 5.5a1.5 1.5 0 1 0 0 .01",
  konkurranser: "M8 4h8v5a4 4 0 0 1-8 0zM8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4M12 13v4M9 20h6",
  konkurranse: "M8 4h8v5a4 4 0 0 1-8 0zM8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4M12 13v4M9 20h6",
};
const d = ICON[cat] ?? ICON["kurs"];
---
{photo
  ? <span class:list={["default-image default-image--photo", className]} data-cat={cat}>
      <img src={url(photo)} alt="" loading="lazy" decoding="async" />
      {label && <span class="default-image__label">{label}</span>}
    </span>
  : <span class:list={["default-image", className]} data-cat={cat} aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false"><path d={d} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      {label && <span>{label}</span>}
    </span>}
