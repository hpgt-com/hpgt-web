# Sikkerhetshoder (Cloudflare). Samme CSP som i <meta>, pluss det som bare kan settes som HTTP-hode.
# cloudflareinsights.com: anonym besøksstatistikk (Cloudflare Web Analytics). Lastes bare når site.json → statistikk er satt.
# hpgt-web.goatcounter.com: anonym besøksstatistikk og klikk (GoatCounter, site.json → goatcounter). Bare tellepunktet.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data: https://hpgt-web.goatcounter.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://hpgt-web.goatcounter.com; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Utkast (forhåndsvisning) skal ikke i søkemotorer
/utkast/*
  X-Robots-Tag: noindex, nofollow

# Skjemaene (RadioID og «Meld feil»): samme regler, men Cloudflare Turnstile får laste skript og vise sin sjekk. Bare disse sidene.
# Må stemme med SKJEMASIDER i src/components/Head.astro.
/for-piloter/radioid/
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data: https://hpgt-web.goatcounter.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://hpgt-web.goatcounter.com; frame-src https://challenges.cloudflare.com https://www.youtube-nocookie.com https://player.vimeo.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

